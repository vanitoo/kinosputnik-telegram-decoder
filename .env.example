# Получить на https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=

# Прокси (опционально). Несколько адресов через запятую, точку с запятой
# или перенос строки. Поддерживаемые схемы: socks5://, socks4://, http:// (https:// для Telethon не поддерживается)
# TG_PROXY=socks5://user:pass@host:1080,http://host2:3128
# Номер телефона необязателен. Используется только при --auth code.
# TG_PHONE=+79991234567

# Режим ProxyManager: off | single | sticky | failover | random | rotate
# failover — приоритетный: первый живой, возврат на primary после восстановления
# TG_PROXY_MODE=failover

# Параметры health-check прокси (секунды; 0 отключает фоновый цикл)
# TG_PROXY_CHECK_URL=https://api.telegram.org
# TG_PROXY_CHECK_TIMEOUT=8
# TG_PROXY_CHECK_INTERVAL=60
